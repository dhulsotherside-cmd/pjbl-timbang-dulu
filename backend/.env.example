# App Configuration
PROJECT_NAME="TimbangDulu API"
VERSION="1.0.0"
API_V1_STR="/api/v1"

# Database Configuration (Neon PostgreSQL - Connection Pooling)
# Wajib menggunakan mode Connection Pooling (-pooler) dan sslmode=require
# Format: postgresql://<user>:<password>@<ep-pooler-host>/<dbname>?sslmode=require
# Contoh Neon: postgresql://neondb_owner:npg_xxxx@ep-cool-dawn-123456-pooler.us-east-2.aws.neon.tech/neondb?sslmode=require
# Contoh SQLite (fallback lokal): sqlite:///./timbangdulu.db
DATABASE_URL=postgresql://<user>:<password>@<ep-pooler-host>/<dbname>?sslmode=require

# Supabase Storage Configuration
SUPABASE_URL="https://your-project-id.supabase.co"
SUPABASE_KEY="your-supabase-service-role-or-anon-key"
SUPABASE_BUCKET_NAME="cattle-images"

# Security & JWT Configuration
SECRET_KEY="ganti-dengan-secret-key-yang-sangat-rahasia-dan-panjang-min-32-karakter"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# AI Model Inference Mock Toggle (True: Mock regression 60-450kg, False: Real Model)
USE_MOCK_AI=True
