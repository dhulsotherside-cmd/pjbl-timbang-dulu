# App Configuration
PROJECT_NAME="TimbangDulu API"
VERSION="1.0.0"
API_V1_STR="/api/v1"

# Database Configuration (PostgreSQL / Supabase)
# Contoh Supabase: postgresql://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT-REF].supabase.co:5432/postgres
# Contoh Local PostgreSQL: postgresql://postgres:postgres@localhost:5432/timbangdulu
# Contoh SQLite (development/fallback): sqlite:///./timbangdulu.db
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/timbangdulu"

# Supabase Storage Configuration
SUPABASE_URL="https://your-project-id.supabase.co"
SUPABASE_KEY="your-supabase-service-role-or-anon-key"
SUPABASE_BUCKET_NAME="cattle-images"

# Security & JWT Configuration
SECRET_KEY="ganti-dengan-secret-key-yang-sangat-rahasia-dan-panjang-min-32-karakter"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# AI Model Inference Mock Toggle (True: Mock regression 60-450kg, False: Real Model)
USE_MOCK_AI=True
