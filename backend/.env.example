# App Configuration
PROJECT_NAME="TimbangDulu API"
VERSION="1.0.0"
API_V1_STR="/api/v1"

# Database Configuration (Neon PostgreSQL - Connection Pooling)
# Wajib menggunakan mode Connection Pooling (-pooler) dan sslmode=require
# Format: postgresql://<user>:<password>@<ep-pooler-host>/<dbname>?sslmode=require
# Contoh Neon: postgresql://neondb_owner:npg_xxxx@ep-cool-dawn-123456-pooler.us-east-2.aws.neon.tech/neondb?sslmode=require
# SQLite lokal. Ganti dengan URL Neon di atas untuk memakai PostgreSQL.
DATABASE_URL=sqlite:///./timbangdulu.db

# Neon Object Storage (S3-Compatible) Configuration - Wajib untuk penyimpanan foto ternak
# Bucket dikelola deklaratif via berkas root neon.ts (bucket: cattle-images, access: public_read)
# Seluruh variabel di bawah ini wajib diisi (arsitektur strict / fail-fast).
AWS_ENDPOINT_URL_S3="https://<project-id>.storage.<region>.neon.tech"
AWS_ACCESS_KEY_ID="<your-neon-storage-access-key-id>"
AWS_SECRET_ACCESS_KEY="<your-neon-storage-secret-access-key>"
AWS_REGION="us-east-2"
NEON_STORAGE_BUCKET_NAME="cattle-images"

# Security & JWT Configuration
SECRET_KEY="ganti-dengan-secret-key-yang-sangat-rahasia-dan-panjang-min-32-karakter"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Path relatif dihitung dari backend/. Restart backend setelah mengubah konfigurasi.
CATTLE_CLASSIFIER_PATH=../model_prediksi/sapibukan_cifor.keras
CATTLE_SEGMENTATION_PATH=../model_prediksi/best_seg_model.keras
CATTLE_REGRESSION_PATH=../model_prediksi/best_reg_model.keras
# Untuk PyTorch, pasang requirements-pytorch.txt lalu ganti CATTLE_CLASSIFIER_PATH
# menjadi ../model_prediksi/klasifikasi_sapibukan.pth.
